---
import Section from '@/components/Section.astro';
import Title from '@/components/Title.astro';
import { SERVICIOS } from '@/data/servicios';
---

<Section id="servicios" class="flex flex-col items-center sm:items-start">
  <Title title="Nuestros servicios." img="/services.png" />

  <div class="mt-[30px] flex w-full flex-col gap-4" id="servicios-accordion">
    {
      SERVICIOS.map((servicio, index) => (
        <div class="servicio-item w-full overflow-hidden text-white" data-index={index}>
          <button
            type="button"
            class="servicio-trigger flex w-full cursor-pointer items-center justify-between overflow-hidden rounded-xl px-4 py-3 text-left bg-primary"
            aria-expanded="false"
          >
            <h3 class="pr-3 text-base font-semibold leading-[1.4] text-white md:text-xl">
              {servicio.title}
            </h3>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="servicio-chevron h-6 w-6 shrink-0 transition-transform duration-200"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>

          <div class="servicio-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300">
            <div class="overflow-hidden">
              <div class="flex flex-col gap-4 bg-white p-4 md:flex-row">
                <div class="w-full md:w-[300px]">
                  <img
                    src={`/${servicio.img}`}
                    alt={servicio.title}
                    class="max-w-full rounded-lg object-cover md:max-w-[300px]"
                    loading="lazy"
                  />
                </div>
                <div class="w-full md:w-[80%]">
                  <h4 class="text-subtitle mb-2 font-bold">Descripción del servicio</h4>
                  <p class="text-body">{servicio.description}</p>
                  <h4 class="text-subtitle mt-4 font-bold">
                    {servicio.subtitle ?? 'Beneficios clave'}
                  </h4>
                  <ul class="mt-2 list-none pl-0">
                    {servicio.list.map((beneficio) => (
                      <li class="text-body py-0">• {beneficio}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<script>
  const accordion = document.getElementById('servicios-accordion');
  if (accordion) {
    const items = accordion.querySelectorAll('.servicio-item');
    let openIndex: number | null = null;

    items.forEach((item, index) => {
      const trigger = item.querySelector('.servicio-trigger') as HTMLButtonElement;
      const panel = item.querySelector('.servicio-panel') as HTMLElement;
      const chevron = item.querySelector('.servicio-chevron') as SVGElement;

      trigger?.addEventListener('click', () => {
        const isOpen = openIndex === index;

        items.forEach((otherItem, otherIndex) => {
          const otherTrigger = otherItem.querySelector('.servicio-trigger') as HTMLButtonElement;
          const otherPanel = otherItem.querySelector('.servicio-panel') as HTMLElement;
          const otherChevron = otherItem.querySelector('.servicio-chevron') as SVGElement;

          if (otherIndex === index && !isOpen) {
            otherTrigger.classList.remove('bg-primary');
            otherTrigger.classList.add('bg-gradient-brand');
            otherPanel.classList.remove('grid-rows-[0fr]');
            otherPanel.classList.add('grid-rows-[1fr]');
            otherChevron.classList.add('rotate-180');
            otherTrigger.setAttribute('aria-expanded', 'true');
          } else {
            otherTrigger.classList.add('bg-primary');
            otherTrigger.classList.remove('bg-gradient-brand');
            otherPanel.classList.add('grid-rows-[0fr]');
            otherPanel.classList.remove('grid-rows-[1fr]');
            otherChevron.classList.remove('rotate-180');
            otherTrigger.setAttribute('aria-expanded', 'false');
          }
        });

        openIndex = isOpen ? null : index;
      });
    });
  }
</script>

---
import Section from '@/components/Section.astro';
import Title from '@/components/Title.astro';
import ServicioCards from '@/components/ServicioCards.astro';
import { CATEGORIAS_SERVICIOS } from '@/data/servicios';
---

<Section id="servicios" class="flex flex-col items-center sm:items-start">
  {
    CATEGORIAS_SERVICIOS.map((categoria, categoriaIndex) => (
      <div
        class:list={['w-full', categoriaIndex > 0 && 'mt-12 md:mt-14']}
        id={categoria.id}
      >
        <Title title={categoria.title} subtitle={categoria.subtitle} img={categoria.img} />
        <ServicioCards items={categoria.items} bg={categoria.bg} />
      </div>
    ))
  }
</Section>

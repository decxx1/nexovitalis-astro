---
import type { ServicioItem } from '@/data/servicios';
import ServicioCard from '@/components/ServicioCard.astro';

interface Props {
  items: ServicioItem[];
  bg: string;
}

const { items, bg } = Astro.props;
---

<div
  class:list={[
    'mt-7.5 grid w-full items-start gap-4',
    items.length === 1
      ? 'max-w-sm grid-cols-1'
      : 'grid-cols-1 sm:grid-cols-2 xl:grid-cols-3',
  ]}
>
  {items.map((item) => <ServicioCard item={item} bg={bg} />)}
</div>

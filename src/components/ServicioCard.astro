---
import type { ServicioItem } from '@/data/servicios';

interface Props {
  item: ServicioItem;
  bg: string;
}

const { item, bg } = Astro.props;

const accentClass =
  bg === 'primary' ? 'bg-primary' : bg === 'secondary' ? 'bg-secondary' : 'bg-tertiary';

const panelId = `servicio-panel-${item.title.toLowerCase().replace(/\s+/g, '-')}`;
---

<article
  class="flex flex-col overflow-hidden rounded-[15px] bg-white shadow-[0_2px_12px_rgba(1,12,125,0.08)]"
  data-servicio-card
>
  <img
    src={`/${item.img}`}
    alt={item.title}
    class="h-36 w-full object-cover sm:h-72"
    loading="lazy"
  />
  <div class="flex flex-col p-4">
    <button
      type="button"
      class:list={[
        'servicio-card-toggle flex w-full cursor-pointer items-center justify-between gap-2 rounded-lg px-3 py-1.5 text-left text-base font-semibold leading-snug text-white transition-[background] duration-300 md:text-lg',
        accentClass,
      ]}
      aria-expanded="false"
      aria-controls={panelId}
      data-servicio-toggle
    >
      <span>{item.title}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="servicio-card-chevron size-5 shrink-0 transition-transform duration-300"
        aria-hidden="true"
        data-servicio-chevron
      >
        <path
          fill-rule="evenodd"
          d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z"
          clip-rule="evenodd"></path>
      </svg>
    </button>
    <div
      id={panelId}
      class="servicio-card-panel"
      data-servicio-panel
      role="region"
    >
      <div class="overflow-hidden">
        <ul class="mt-2.5 list-none columns-1 gap-x-4 pl-0 text-sm leading-snug text-text sm:columns-2">
          {
            item.list.map((entry) => (
              <li class="mb-1 break-inside-avoid pl-0">• {entry}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</article>

<style>
  .servicio-card-toggle[aria-expanded='true'] {
    background: linear-gradient(
      to right,
      rgb(1 12 125),
      rgb(217 64 189),
      rgb(212 136 64)
    );
  }

  .servicio-card-toggle[aria-expanded='true'] .servicio-card-chevron {
    transform: rotate(180deg);
  }

  .servicio-card-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease-in-out;
  }

  .servicio-card-panel.is-open {
    grid-template-rows: 1fr;
  }
</style>

<script>
  function initServicioCards() {
    document.querySelectorAll('[data-servicio-card]').forEach((card) => {
      if (!(card instanceof HTMLElement) || card.dataset.ready === 'true') return;
      card.dataset.ready = 'true';

      const btn = card.querySelector('[data-servicio-toggle]');
      const panel = card.querySelector('[data-servicio-panel]');
      if (!(btn instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        panel.classList.toggle('is-open', !open);
      });
    });
  }

  initServicioCards();
  document.addEventListener('astro:page-load', initServicioCards);
</script>

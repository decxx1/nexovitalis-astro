---
import type { ServicioItem } from '@/data/servicios';

interface Props {
  items: ServicioItem[];
  bg: string;
}

const { items, bg } = Astro.props;
---

<div class="servicios-accordion mt-7.5 flex w-full flex-col gap-4" data-bg={bg}>
  {
    items.map((item, index) => (
      <div class="servicio-item w-full overflow-hidden text-white" data-index={index}>
        <button
          type="button"
          class:list={['servicio-trigger flex w-full cursor-pointer items-center justify-between overflow-hidden rounded-xl px-4 py-3 text-left', bg === 'primary' ? 'bg-primary' : bg === 'secondary' ? 'bg-secondary' : 'bg-tertiary']}
          aria-expanded="false"
        >
          <h3 class="pr-3 text-base font-semibold leading-[1.4] text-white md:text-xl">
            {item.title}
          </h3>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="servicio-chevron h-6 w-6 shrink-0 transition-transform duration-200"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <div class="servicio-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300">
          <div class="overflow-hidden">
            <div class="flex flex-col gap-4 bg-white p-4 md:flex-row">
              <div class="w-full md:w-75">
                <img
                  src={`/${item.img}`}
                  alt={item.title}
                  class="max-w-full rounded-lg object-cover md:max-w-75"
                  loading="lazy"
                />
              </div>
              <div class="w-full md:w-[80%]">
                <ul class="list-none pl-0">
                  {item.list.map((entry) => (
                    <li class="text-body py-0">• {entry}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))
  }
</div>

---
interface Props {
  img: string;
  title: string;
  subtitle?: string;
  class?: string;
  titleClass?: string;
  subtitleClass?: string;
  light?: boolean;
}

const {
  img,
  title,
  subtitle,
  class: className = '',
  titleClass = '',
  subtitleClass = '',
  light = false,
} = Astro.props;
---

<div
  class:list={[
    'flex flex-col items-center justify-center gap-5 sm:flex-row sm:justify-start',
    className,
  ]}
>
  <img src={img} alt="" width="65" height="65" class="h-[65px] w-[65px] shrink-0" />
  <div class="flex flex-col text-center sm:text-left">
    <h2
      class:list={[
        'text-title',
        light && 'text-white',
        titleClass,
      ]}
    >
      {title}
    </h2>
    {
      subtitle && (
        <p class:list={['text-subtitle mt-2', light && 'text-white', subtitleClass]}>
          {subtitle}
        </p>
      )
    }
  </div>
</div>

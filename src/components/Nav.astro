---
import { site } from '@/lib/site';

const navLinks = [
  { id: 'about', label: 'QUÉ HACEMOS' },
  { id: 'servicios', label: 'SERVICIOS' },
  { id: 'compromiso', label: 'COMPROMISO' },
  { id: 'cadeid', label: 'CADEID' },
  { id: 'contacto', label: 'CONTACTO' },
];

const socialLinks = [
  { url: site.facebook, label: 'Facebook', icon: 'facebook' },
  { url: site.instagram, label: 'Instagram', icon: 'instagram' },
  { url: site.linkedin, label: 'LinkedIn', icon: 'linkedin' },
].filter((link) => link.url);
---

<header
  id="site-nav"
  class="fixed top-0 left-0 z-110 flex h-20 w-full items-center justify-between bg-white px-[30px] shadow-[0_2px_10px_rgba(0,0,0,0.1)] transition-transform duration-300 ease-in-out md:px-[60px]"
>
  <img src="/navLogo.png" alt="Nexovitalis" class="z-999 h-[47px]" />

  <nav class="hidden gap-[30px] md:flex" aria-label="Principal">
    {
      navLinks.map((link) => (
        <button type="button" class="nav-link" data-scroll-to={link.id}>
          {link.label}
        </button>
      ))
    }
  </nav>

  <button
    type="button"
    id="nav-menu-open"
    class="flex text-primary transition-transform duration-300 hover:rotate-180 md:hidden"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="nav-mobile-menu"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
    </svg>
  </button>
</header>

<div
  id="nav-mobile-menu"
  class="pointer-events-none fixed top-0 left-0 z-999 flex h-screen w-full flex-col items-center justify-center bg-black/60 opacity-0 backdrop-blur-[30px] transition-opacity duration-200"
  aria-hidden="true"
>
  <button
    type="button"
    id="nav-menu-close"
    class="absolute top-5 right-[30px] text-white transition-transform duration-300 hover:rotate-180"
    aria-label="Cerrar menú"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <nav class="mb-[150px] flex flex-col items-center gap-5" aria-label="Menú móvil">
    {
      navLinks.map((link) => (
        <button type="button" class="nav-link-mobile" data-scroll-to={link.id}>
          {link.label}
        </button>
      ))
    }
    {
      socialLinks.length > 0 && (
        <div class="mt-5 flex gap-5">
          {
            socialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[28px] text-white transition-colors duration-200 hover:text-secondary"
                aria-label={link.label}
              >
                {link.icon === 'facebook' && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7">
                    <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
                  </svg>
                )}
                {link.icon === 'instagram' && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                  </svg>
                )}
                {link.icon === 'linkedin' && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 114.126 0 2.063 2.063 0 01-2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      )
    }
  </nav>
</div>

<script>
  const nav = document.getElementById('site-nav');
  const mobileMenu = document.getElementById('nav-mobile-menu');
  const openBtn = document.getElementById('nav-menu-open');
  const closeBtn = document.getElementById('nav-menu-close');

  const SCROLL_OFFSET = 80;
  const SCROLL_DELTA = 8;
  let lastScrollY = window.scrollY;
  let ticking = false;

  function isMenuOpen() {
    return mobileMenu?.classList.contains('opacity-100') ?? false;
  }

  function setMenuOpen(open: boolean) {
    if (!mobileMenu || !openBtn) return;

    mobileMenu.classList.toggle('pointer-events-none', !open);
    mobileMenu.classList.toggle('opacity-0', !open);
    mobileMenu.classList.toggle('opacity-100', open);
    mobileMenu.setAttribute('aria-hidden', String(!open));
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  function scrollToSection(sectionId: string) {
    const section = document.getElementById(sectionId);
    if (section) {
      section.scrollIntoView({ behavior: 'smooth' });
    }
    setMenuOpen(false);
  }

  openBtn?.addEventListener('click', () => setMenuOpen(true));
  closeBtn?.addEventListener('click', () => setMenuOpen(false));

  document.querySelectorAll('[data-scroll-to]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sectionId = btn.getAttribute('data-scroll-to');
      if (sectionId) scrollToSection(sectionId);
    });
  });

  function updateNavOnScroll() {
    if (!nav) return;

    const currentScrollY = window.scrollY;
    const delta = currentScrollY - lastScrollY;

    if (currentScrollY <= SCROLL_OFFSET || isMenuOpen()) {
      nav.classList.remove('-translate-y-full');
      nav.classList.add('shadow-[0_2px_10px_rgba(0,0,0,0.1)]');
    } else if (delta > SCROLL_DELTA) {
      nav.classList.add('-translate-y-full');
      nav.classList.remove('shadow-[0_2px_10px_rgba(0,0,0,0.1)]');
    } else if (delta < -SCROLL_DELTA) {
      nav.classList.remove('-translate-y-full');
      nav.classList.add('shadow-[0_2px_10px_rgba(0,0,0,0.1)]');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(updateNavOnScroll);
        ticking = true;
      }
    },
    { passive: true },
  );
</script>
